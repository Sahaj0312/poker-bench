# Copy this file to .env. Enter keys here or in Model lineup.
# Each slot accepts NAME, KIND, MODEL, URL, and KEY.
# KIND accepts codex, compatible, anthropic, or typesafe.

RIVER_ASTRA_NAME=Astra
RIVER_ASTRA_KIND=codex
RIVER_ASTRA_MODEL=gpt-6.2-astra
RIVER_ASTRA_URL=
RIVER_ASTRA_KEY=

RIVER_OPUS_NAME=Opus
RIVER_OPUS_KIND=anthropic
RIVER_OPUS_MODEL=
RIVER_OPUS_URL=https://api.anthropic.com/v1/messages
RIVER_OPUS_KEY=

RIVER_MUSE_NAME=Muse
RIVER_MUSE_KIND=compatible
RIVER_MUSE_MODEL=
RIVER_MUSE_URL=
RIVER_MUSE_KEY=

RIVER_GEMINI_NAME=Gemini
RIVER_GEMINI_KIND=compatible
RIVER_GEMINI_MODEL=
RIVER_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
RIVER_GEMINI_KEY=

RIVER_JEV_NAME=Jev
RIVER_JEV_KIND=typesafe
RIVER_JEV_MODEL=jev-1.14.0
RIVER_JEV_URL=https://api.typesafe.ai/v1/systemone
RIVER_JEV_KEY=
